# Hypixel SkyBlock AH Monitor Configuration

# Hypixel API key (optional for public /skyblock/auctions endpoint)
HYPIXEL_API_KEY=

# Discord Webhook URL for alert dispatching (required unless DRY_RUN=true)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Profit & Arbitrage Thresholds
MIN_PROFIT_COINS=1000000
MIN_PROFIT_MARGIN_PCT=15.0
MIN_SAMPLE_SIZE=3
MAX_TARGET_TO_BUY_RATIO=3.0
# AH_TAX_RATE=0.02  # Deprecated: creation + collection fee model in src/constants/taxes.py is used

# Mayor & Election Fee Settings
DERPY_COLLECTION_FEE_RATE=0.04
MAYOR_OVERRIDE=
ELECTION_CACHE_TTL_SECONDS=600

# Execution & Polling Settings
POLL_INTERVAL_SECONDS=60
DRY_RUN=false

# Pet Valuation & Sales Gate
# Format: JSON string representing min sales by rarity in last 48h
PET_MIN_SALES_BY_RARITY='{"COMMON":8,"UNCOMMON":8,"RARE":6,"EPIC":4,"LEGENDARY":3,"MYTHIC":3}'

# Market Intelligence & Guards (Phase 3)
ENABLE_SOLD_COMPS=true
ENABLE_DYNAMIC_RETENTION=true
ENABLE_BAZAAR_SHOCK_GUARD=true
ENABLE_SELLER_DOMINATION_GUARD=true
MIN_COMPS_FOR_HIGH=5
SHADOW_MODE_LANES=
COLD_START_MIN_SALES=50

# Outcome Labeling & Calibration (Phase 4)
ENABLE_OUTCOME_LABELING=true
OUTCOME_HORIZON_HOURS=6.0
SNIPE_SURVIVAL_MINUTES=15.0

# Valuation Realism (Phase 5)
QUICK_SALE_QUANTILE=0.25


